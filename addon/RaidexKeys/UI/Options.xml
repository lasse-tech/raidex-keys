<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <Frame name="RaidexKeysAboutTemplate" mixin="RaidexKeysAboutMixin" virtual="true">
        <Size y="45"/>
        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="Text" inherits="GameFontHighlightSmall" justifyH="LEFT" justifyV="TOP">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="7" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="Chip">
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture parentKey="Bg" setAllPoints="true">
                            <Color r="0.655" g="0.545" b="1" a="0.18"/>
                        </Texture>
                    </Layer>
                    <Layer level="OVERLAY">
                        <FontString parentKey="Label" inherits="GameFontNormalSmall" justifyH="CENTER">
                            <Anchors>
                                <Anchor point="CENTER"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
        </Frames>
    </Frame>
    <Frame name="RaidexKeysColorTemplate" mixin="RaidexKeysColorMixin" virtual="true">
        <Size y="26"/>
        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="Label" inherits="GameFontHighlight" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="LEFT" x="7" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button parentKey="Swatch">
                <Size x="30" y="16"/>
                <Anchors>
                    <Anchor point="LEFT" x="300" y="0"/>
                </Anchors>
                <Layers>
                    <Layer level="BORDER">
                        <Texture parentKey="Edge" setAllPoints="true"/>
                    </Layer>
                    <Layer level="ARTWORK">
                        <Texture parentKey="Fill">
                            <Anchors>
                                <Anchor point="TOPLEFT" x="1" y="-1"/>
                                <Anchor point="BOTTOMRIGHT" x="-1" y="1"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
            </Button>
        </Frames>
    </Frame>
</Ui>
