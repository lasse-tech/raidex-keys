<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RaidexKeys</AssemblyName>
    <RootNamespace>RaidexKeys.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\raidex-keys.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The about dialog reads it from the assembly. -->
    <Version>0.18.0</Version>
    <Product>Raidex Keys</Product>
    <Copyright>© 2026 lasse tech, Lars Gossard</Copyright>
    <!-- German is the neutral language; English ships as a satellite assembly. -->
    <NeutralLanguage>de</NeutralLanguage>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
    <!-- A single file really is single: Skia and HarfBuzz travel inside it and
         unpack themselves at start. As separate .so/.dll files beside it they
         went missing in an install (DllNotFoundException: libSkiaSharp). -->
    <IncludeNativeLibrariesForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- Strongly typed access to the strings (Strings.Overview …), generated at
       build time — the command line has no ResXFileCodeGenerator. -->
  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>RaidexKeys.App.Localization</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RaidexKeys.Core\RaidexKeys.Core.csproj" />
  </ItemGroup>
</Project>
