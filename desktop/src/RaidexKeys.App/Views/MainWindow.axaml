<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RaidexKeys.App.ViewModels"
        xmlns:views="using:RaidexKeys.App.Views"
        xmlns:l="using:RaidexKeys.App.Localization"
        x:Class="RaidexKeys.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="{x:Static l:Strings.AppTitle}"
        Width="1080" Height="720" MinWidth="920" MinHeight="540"
        WindowStartupLocation="CenterScreen">

  <!--
    The pages as tabs along the top (Lars, 2026-09-30; the guide's section 05
    draws a sidebar). The brand on the left, notes on the right.
  -->
  <Grid RowDefinitions="Auto,*">
    <Border Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Height="56">
        <Viewbox Height="26" Margin="22,0,26,0" VerticalAlignment="Center">
          <views:Brandmark />
        </Viewbox>

        <ListBox Grid.Column="1" ItemsSource="{Binding Sections}"
                 SelectedItem="{Binding Selected}"
                 ItemContainerTheme="{StaticResource NavItemTheme}"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SectionViewModel">
              <TextBlock Text="{Binding Title}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" Margin="12,0,20,0" VerticalAlignment="Center">
          <!-- Another Raidex than raidex.app (RAIDEXKEYS_SERVER or settings.json): said where it is always in sight -->
          <Border Classes="pill server" IsVisible="{Binding ShowsServerBadge}" ToolTip.Tip="{Binding ServerBadgeTip}">
            <TextBlock Text="{Binding ServerBadge}" />
          </Border>
          <Border Classes="pill" IsVisible="{Binding ShowsPreviewBadge}">
            <TextBlock Text="{Binding PreviewBadge}" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- A newer version: said once over the page, waved away with "Später". -->
    <DockPanel Grid.Row="1">
      <Border DockPanel.Dock="Top" Classes="strip" DataContext="{Binding Updates}"
              x:DataType="vm:UpdateStatus" IsVisible="{Binding ShowStrip}">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Line}" />
          <Button Grid.Column="1" Classes="primary" Margin="16,0,8,0"
                  Content="{Binding GetLabel}" Command="{Binding OpenPageCommand}" />
          <Button Grid.Column="2" Classes="ghost" Content="{x:Static l:Strings.UpdateDismiss}"
                  Command="{Binding DismissCommand}" />
        </Grid>
      </Border>
      <ContentControl Content="{Binding Selected}" />
    </DockPanel>
  </Grid>
</Window>
