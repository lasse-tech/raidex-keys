<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:RaidexKeys.App.Views"
             xmlns:rating="using:RaidexKeys.Core.Rating"
             x:Class="RaidexKeys.App.Views.RoleIcon"
             x:DataType="views:RoleIcon"
             Width="16" Height="16">
  <!--
    Tank, healer, damage - drawn here, not Blizzard's own. The game's role
    icons live in the client's UI atlas: they are not on any public address
    and not ours to ship. Shield, cross and sword say the same thing, in the
    brand's weight.
  -->
  <Panel>
    <Path Classes="role"
          Data="M8,1.6 L13.4,3.5 V8 C13.4,11.1 11.1,13.6 8,14.4 C4.9,13.6 2.6,11.1 2.6,8 V3.5 Z">
      <Path.IsVisible>
        <Binding Path="Role" RelativeSource="{RelativeSource AncestorType=views:RoleIcon}"
                 Converter="{x:Static views:RoleIcon.Is}" ConverterParameter="{x:Static rating:GroupRole.Tank}" />
      </Path.IsVisible>
    </Path>
    <Path Classes="role"
          Data="M6.6,2.4 H9.4 V6.6 H13.6 V9.4 H9.4 V13.6 H6.6 V9.4 H2.4 V6.6 H6.6 Z">
      <Path.IsVisible>
        <Binding Path="Role" RelativeSource="{RelativeSource AncestorType=views:RoleIcon}"
                 Converter="{x:Static views:RoleIcon.Is}" ConverterParameter="{x:Static rating:GroupRole.Healer}" />
      </Path.IsVisible>
    </Path>
    <Path Classes="role"
          Data="M4.4,10.4 L12.2,2.6 L14,2 L13.4,3.8 L5.6,11.6 Z M3.6,8.8 L7.2,12.4 L6.4,13.2 L2.8,9.6 Z">
      <Path.IsVisible>
        <Binding Path="Role" RelativeSource="{RelativeSource AncestorType=views:RoleIcon}"
                 Converter="{x:Static views:RoleIcon.Is}" ConverterParameter="{x:Static rating:GroupRole.Damage}" />
      </Path.IsVisible>
    </Path>
    <!-- Nobody said which role: a hollow ring, so the row keeps its rhythm -->
    <Ellipse Classes="role" Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"
             StrokeThickness="1.4" Fill="Transparent">
      <Ellipse.IsVisible>
        <Binding Path="Role" RelativeSource="{RelativeSource AncestorType=views:RoleIcon}"
                 Converter="{x:Static views:RoleIcon.Is}" ConverterParameter="{x:Static rating:GroupRole.Unknown}" />
      </Ellipse.IsVisible>
    </Ellipse>
  </Panel>
</UserControl>
